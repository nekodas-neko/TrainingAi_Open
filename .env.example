# ── Database ──────────────────────────────────────────────────────────────────
# Railway Postgres — copy DATABASE_PUBLIC_URL value here for local dev; Railway uses internal URL automatically
DATABASE_URL=
# Set to "true" when connecting to Railway Postgres from outside Railway (local dev)
DATABASE_SSL=false

# ── Auth (Auth.js v5) ─────────────────────────────────────────────────────────
# Required: JWT signing secret
AUTH_SECRET=
# Required in production: your Railway app URL (prevents redirect URI mismatches)
AUTH_URL=https://your-app.up.railway.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console:
#   Local dev:   http://localhost:3000/api/auth/callback/google
#   Production:  https://your-app.up.railway.app/api/auth/callback/google
GOOGLE_REDIRECT_URI=

# ── AI ────────────────────────────────────────────────────────────────────────
# Used by @ai-sdk/google for the AI chat feature
GOOGLE_GENERATIVE_AI_API_KEY=
# Used explicitly by the TTS route — can be the same key as GOOGLE_GENERATIVE_AI_API_KEY
GEMINI_API_KEY=

# ── Admin bootstrap (optional) ───────────────────────────────────────────────
# Grants `users.is_admin` to this address at server boot, re-checked every deploy so it lands even
# if the account is created later. `users.is_admin` stays the only source of truth — this just sets
# it. Leave unset and no admin is granted: a fresh database has no admin user until you set this or
# flip the column by hand.
ADMIN_EMAIL=

# ── Health Connect webhook (Tasker integration — not needed for local dev) ────
HEALTH_CONNECT_INGEST_SECRET=
# Postgres user ID (UUID) that receives Health Connect webhook data
WEBHOOK_USER_ID=

# ── Object storage (S3-compatible) ───────────────────────────────────────────
# Serves exercise gifs AND the ONNX model files, which are fetched at runtime rather than
# committed. Without these the hypnogram and ring step count degrade silently — the loaders are
# infallible by contract — so the boot check in instrumentation-node.ts exists to say so out loud.
# Either prefix works; AWS_* wins when both are set.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_REGION=
# Public base URL for served media. Derived from the endpoint when unset.
STORAGE_PUBLIC_URL=

# ── Oura Cloud OAuth (optional — the ring is read over direct BLE) ───────────
# Only needed for the Oura Cloud connection and its webhook. The ring itself does not use these.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=
OURA_WEBHOOK_CALLBACK_URL=
OURA_WEBHOOK_VERIFICATION_TOKEN=
# Encrypts stored Oura tokens at rest (aes-256-gcm). 32 bytes hex: `openssl rand -hex 32`.
# Unset means tokens are stored as plaintext — set it.
TOKEN_ENC_KEY=

# ── Web push ─────────────────────────────────────────────────────────────────
# Generate with `npx web-push generate-vapid-keys`. The public key is also referenced client-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Admin / diagnostics (all optional, all fail closed when unset) ───────────
# Read-only SQL over the curated claude_ro views. Both must be set or the endpoint is disabled.
CLAUDE_DB_READONLY_URL=
CLAUDE_DB_QUERY_SECRET=
# Bearer access to GET /api/admin/day-review without a browser session. Treat as a credential —
# it reads that user's health history. `openssl rand -hex 32`.
ADMIN_EXPORT_SECRET=
ADMIN_EXPORT_USER_ID=
# Read-only GitHub PAT so /api/download-apk can read the APK release. Required only while the
# repository is private; an unauthenticated call 404s.
GITHUB_RELEASES_TOKEN=
# Which repo publishes the rolling apk-latest release. Defaults to the pre-cut repository. Set this
# at the public-repo cut — otherwise the update card keeps reading the ARCHIVED repo's release,
# which still returns 200 and whose version never changes again.
APK_RELEASE_REPO=

# ── Maps (optional) ──────────────────────────────────────────────────────────
# Thunderforest "Atlas" tiles for the activity-route map. Public (NEXT_PUBLIC_*,
# inlined into the client bundle) — domain/referrer-restrict it in the Thunderforest
# dashboard if your plan offers that (not available on all tiers, e.g. Hobby Project).
# When unset, the map falls back to plain OpenStreetMap tiles.
NEXT_PUBLIC_THUNDERFOREST_API_KEY=
