<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/home_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/home_widget_background"
  android:orientation="vertical"
  android:paddingHorizontal="14dp"
  android:paddingVertical="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/home_widget_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:text="@string/home_widget_nutrition_title"
      android:textAllCaps="true"
      android:textColor="@color/home_widget_muted"
      android:textSize="10sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/home_widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="@color/home_widget_muted"
      android:textSize="11sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/home_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:textColor="@color/home_widget_text"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/home_widget_nutrition_body"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:gravity="bottom"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/home_widget_kcal_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/home_widget_text"
        android:textSize="30sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/home_widget_kcal_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="4dp"
        android:textColor="@color/home_widget_muted"
        android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal">
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginEnd="10dp"
      android:orientation="vertical">
      <TextView
        android:id="@+id/home_widget_protein_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/home_widget_text"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/home_widget_protein_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:maxLines="1"
        android:textColor="@color/home_widget_muted"
        android:textSize="11sp" />
      <ProgressBar
        android:id="@+id/home_widget_protein_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progressDrawable="@drawable/home_widget_bar_protein" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginEnd="10dp"
      android:orientation="vertical">
      <TextView
        android:id="@+id/home_widget_carbs_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/home_widget_text"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/home_widget_carbs_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:maxLines="1"
        android:textColor="@color/home_widget_muted"
        android:textSize="11sp" />
      <ProgressBar
        android:id="@+id/home_widget_carbs_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progressDrawable="@drawable/home_widget_bar_carbs" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginEnd="0dp"
      android:orientation="vertical">
      <TextView
        android:id="@+id/home_widget_fat_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/home_widget_text"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/home_widget_fat_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:maxLines="1"
        android:textColor="@color/home_widget_muted"
        android:textSize="11sp" />
      <ProgressBar
        android:id="@+id/home_widget_fat_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progressDrawable="@drawable/home_widget_bar_fat" />
    </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="bottom"
      android:orientation="horizontal">
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="3dp"
          android:orientation="horizontal">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_widget_water_title"
            android:textColor="@color/home_widget_text"
            android:textSize="12sp" />
          <TextView
            android:id="@+id/home_widget_water_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/home_widget_muted"
            android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar
          android:id="@+id/home_widget_water_bar"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent"
          android:layout_height="6dp"
          android:max="100"
          android:progressDrawable="@drawable/home_widget_bar_water" />
      </LinearLayout>
      <TextView
        android:id="@+id/home_widget_add_water"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/home_widget_button"
        android:contentDescription="@string/home_widget_add_water_description"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="@string/home_widget_add_water"
        android:textColor="@color/home_widget_onbrand"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
