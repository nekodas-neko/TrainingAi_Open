<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/home_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/home_widget_background"
  android:orientation="vertical"
  android:paddingHorizontal="14dp"
  android:paddingVertical="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/home_widget_eyebrow"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:text=""
      android:textAllCaps="true"
      android:textColor="@color/home_widget_muted"
      android:textSize="10sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/home_widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="@color/home_widget_muted"
      android:textSize="11sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/home_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:textColor="@color/home_widget_text"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/home_widget_next_body"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
      android:id="@+id/home_widget_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:maxLines="2"
      android:ellipsize="end"
      android:textColor="@color/home_widget_text"
      android:textSize="22sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/home_widget_meta"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:maxLines="2"
      android:ellipsize="end"
      android:textColor="@color/home_widget_muted"
      android:textSize="12sp" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="bottom"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/home_widget_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/home_widget_button"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:paddingVertical="9dp"
        android:textColor="@color/home_widget_onbrand"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/home_widget_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/home_widget_button_ghost"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:paddingVertical="9dp"
        android:textColor="@color/home_widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
