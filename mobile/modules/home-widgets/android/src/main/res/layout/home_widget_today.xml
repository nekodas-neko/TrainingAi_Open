<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/home_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/home_widget_background"
  android:orientation="vertical"
  android:paddingHorizontal="14dp"
  android:paddingVertical="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/home_widget_today_title"
      android:textColor="@color/home_widget_muted"
      android:textSize="11sp" />
    <TextView
      android:id="@+id/home_widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@color/home_widget_muted"
      android:textSize="11sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/home_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:text="@string/home_widget_empty"
    android:textColor="@color/home_widget_text"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/home_widget_scores"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <include android:id="@+id/home_widget_cell_0" layout="@layout/home_widget_cell_0" />
    <include android:id="@+id/home_widget_cell_1" layout="@layout/home_widget_cell_1" />
    <include android:id="@+id/home_widget_cell_2" layout="@layout/home_widget_cell_2" />
    <include android:id="@+id/home_widget_cell_3" layout="@layout/home_widget_cell_3" />
  </LinearLayout>
</LinearLayout>
