<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/home_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/home_widget_background"
  android:orientation="vertical"
  android:paddingHorizontal="14dp"
  android:paddingVertical="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/home_widget_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:text="@string/home_widget_today_title"
      android:textAllCaps="true"
      android:textColor="@color/home_widget_muted"
      android:textSize="10sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/home_widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="@color/home_widget_muted"
      android:textSize="11sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/home_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:textColor="@color/home_widget_text"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/home_widget_scores"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <LinearLayout
      android:id="@+id/home_widget_cell_0"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:id="@+id/home_widget_label_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/home_widget_muted"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/home_widget_value_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/home_widget_text"
        android:textSize="22sp"
        android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/home_widget_cell_1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:id="@+id/home_widget_label_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/home_widget_muted"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/home_widget_value_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/home_widget_text"
        android:textSize="22sp"
        android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/home_widget_cell_2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:id="@+id/home_widget_label_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/home_widget_muted"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/home_widget_value_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/home_widget_text"
        android:textSize="22sp"
        android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/home_widget_cell_3"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:id="@+id/home_widget_label_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/home_widget_muted"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/home_widget_value_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/home_widget_text"
        android:textSize="22sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/home_widget_battery"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical"
    android:visibility="gone">
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@drawable/home_widget_divider" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal">
      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/home_widget_battery_title"
        android:textColor="@color/home_widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/home_widget_battery_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/home_widget_muted"
        android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/home_widget_battery_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/home_widget_text"
        android:textSize="24sp"
        android:textStyle="bold" />
      <ProgressBar
        android:id="@+id/home_widget_battery_bar_good"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_weight="1"
        android:max="100"
        android:progressDrawable="@drawable/home_widget_bar_good"
        android:visibility="gone" />
      <ProgressBar
        android:id="@+id/home_widget_battery_bar_low"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_weight="1"
        android:max="100"
        android:progressDrawable="@drawable/home_widget_bar_low"
        android:visibility="gone" />
      <ProgressBar
        android:id="@+id/home_widget_battery_bar_drained"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_weight="1"
        android:max="100"
        android:progressDrawable="@drawable/home_widget_bar_drained"
        android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
