<?xml version="1.0" encoding="utf-8"?>
<!--
  OR-159 — keep the WebView session cookie out of Google Drive backup.

  `android:allowBackup="true"` with no rules meant Auto Backup took whatever the app stored,
  including `app_webview/Cookies`. That cookie is a live credential: restored onto another
  device it is a signed-in session.

  Scoped to the cookie deliberately. The Oura ring key lives in `shared_prefs/oura_ble.xml` and
  is a SEPARATE decision the owner has not made (OR-160) — it is left exactly as it is here, and
  must not be settled by implication from this file.

  This is the API 23-30 format; `data_extraction_rules.xml` is its API 31+ counterpart, and both
  are needed because minSdk is 26 and targetSdk is 36.
-->
<full-backup-content>
    <exclude domain="root" path="app_webview" />
</full-backup-content>
